# Скопируй этот файл в .env и заполни значения, помеченные TODO.
# .env в репозиторий не попадает (он в .gitignore).

# --- Airflow ---
# На macOS рекомендуемое значение из документации Airflow
AIRFLOW_UID=50000
# Логин и пароль для веб-интерфейса Airflow (http://localhost:8080)
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow
# Ключ шифрования паролей в метаданных Airflow. Сгенерировать:
#   openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=TODO

# --- Образ Airflow ---
# docker-compose.yaml берёт образ <NAMESPACE>/<REPOSITORY>:latest.
# Для локального запуска собираем его сами:
#   docker build -t local/youtube-dq-airflow:latest .
DOCKERHUB_NAMESPACE=local
DOCKERHUB_REPOSITORY=youtube-dq-airflow

# --- PostgreSQL: суперпользователь контейнера ---
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_PASSWORD=postgres
# Внутри сети Docker сервис называется postgres и слушает порт 5432.
# С Mac база доступна на localhost:5433.
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# --- База метаданных Airflow ---
METADATA_DATABASE_NAME=airflow_metadata
METADATA_DATABASE_USERNAME=airflow_meta
METADATA_DATABASE_PASSWORD=airflow_meta

# --- База результатов Celery ---
CELERY_BACKEND_NAME=celery_results
CELERY_BACKEND_USERNAME=celery
CELERY_BACKEND_PASSWORD=celery

# --- База с данными пайплайна ---
ELT_DATABASE_NAME=elt_db
ELT_DATABASE_USERNAME=yt_api_user
ELT_DATABASE_PASSWORD=yt_api_user

# --- YouTube Data API v3 ---
# Ключ из Google Cloud Console
API_KEY=TODO
# Хэндл канала без @
CHANNEL_HANDLE=3blue1brown
